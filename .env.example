# ==============================================================================
# The BC Cargo & Courier — Production Environment Configuration
# ==============================================================================
# Copy this file to .env and configure values before starting the application.
# NEVER commit .env to source control or expose server keys to the frontend.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND PUBLIC ENVIRONMENT VARIABLES
# Exposed to the browser via Vite during client-side build (VITE_* prefix)
# ------------------------------------------------------------------------------
# Public URL of your Supabase project (e.g., https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Public publishable anonymous key for client Supabase SDK
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Cloudflare Turnstile CAPTCHA public site key (free anti-bot verification)
# Get from: https://dash.cloudflare.com/?to=/:account/turnstile
VITE_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key-here

# ------------------------------------------------------------------------------
# 2. STANDALONE PRODUCTION SERVER & AI PROXY (server.js / Docker)
# Strictly server-side; NEVER exposed to the frontend bundle
# ------------------------------------------------------------------------------
# Server listening port (default: 3000)
PORT=3000

# Server bind host (use 0.0.0.0 for Docker containers, 127.0.0.1 for local only)
HOST=0.0.0.0

# OpenRouter API Key for server-side AI chatbot proxy and blog fixer
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Default AI Model ID
DEFAULT_AI_MODEL=google/gemma-4-26b-a4b-it:free

# ------------------------------------------------------------------------------
# 3. SUPABASE EDGE FUNCTIONS SECRETS (Configure via Supabase CLI or Dashboard)
# Set via: supabase secrets set KEY=VALUE
# ------------------------------------------------------------------------------
# Privileged service role key for database operations in Edge Functions
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Cloudflare Turnstile secret key for server-side siteverify verification
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key

# Transactional Email notification provider API key (Resend / SendGrid)
EMAIL_PROVIDER_API_KEY=your-email-provider-api-key

# Transactional Email sender address
EMAIL_FROM_ADDRESS=notifications@thebccargo.com

# SMS Provider API Key (Sparrow SMS / Twilio)
SMS_PROVIDER_API_KEY=your-sms-provider-api-key

# SMS Sender ID
SMS_SENDER_ID=BCCARGO
