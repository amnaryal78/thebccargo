{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.thebccargo.com"
        }
      ],
      "destination": "https://thebccargo.com/:path",
      "permanent": true
    },
    {
      "source": "/rates/national",
      "destination": "/rates",
      "permanent": true
    },
    {
      "source": "/rates/calculator",
      "destination": "/rates",
      "permanent": true
    },
    {
      "source": "/services/courier-nat",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/haulage-nat",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/nepal-domestic-express",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/domestic-express-cargo",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/send-parcel-nepal-to-south-korea",
      "destination": "/blogs/nepal-to-south-korea",
      "permanent": true
    },
    {
      "source": "/send-parcel-nepal-to-malaysia",
      "destination": "/blogs/nepal-to-malaysia",
      "permanent": true
    },
    {
      "source": "/send-parcel-nepal-to-uk",
      "destination": "/blogs/nepal-to-united-kingdom",
      "permanent": true
    },
    {
      "source": "/send-parcel-nepal-to-japan",
      "destination": "/blogs/nepal-to-japan",
      "permanent": true
    },
    {
      "source": "/send-parcel-nepal-to-hong-kong",
      "destination": "/blogs/nepal-to-hong-kong",
      "permanent": true
    },
    {
      "source": "/send-parcel-nepal-to-usa",
      "destination": "/blogs/nepal-to-usa",
      "permanent": true
    },
    {
      "source": "/rates/international",
      "destination": "/rates",
      "permanent": true
    },
    {
      "source": "/rates/rfq",
      "destination": "/rates",
      "permanent": true
    },
    {
      "source": "/careers/customs-broker-specialist",
      "destination": "/careers",
      "permanent": true
    },
    {
      "source": "/careers/air-cargo-operations-lead",
      "destination": "/careers",
      "permanent": true
    },
    {
      "source": "/careers/cross-border-fleet-dispatcher",
      "destination": "/careers",
      "permanent": true
    },
    {
      "source": "/careers/warehouse-sortation-supervisor",
      "destination": "/careers",
      "permanent": true
    },
    {
      "source": "/blogs/nepal-air-cargo-customs-guide-2026",
      "destination": "/blogs",
      "permanent": true
    },
    {
      "source": "/blogs/kolkata-dry-port-rail-transit-guide",
      "destination": "/blogs",
      "permanent": true
    },
    {
      "source": "/blogs/cold-chain-pharma-logistics-nepal",
      "destination": "/blogs",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://thebccargo.onrender.com/api/:path*"
    },
    {
      "source": "/:route(login|track|book|services|rates|blogs|about|contact|policies|how-to-ship|faq|become-a-partner|careers|admin|_kit|profile|messages|reseller)",
      "destination": "/"
    },
    {
      "source": "/:route(services|rates|blogs|careers|admin)/:rest*",
      "destination": "/"
    },
    {
      "source": "/send-parcel-nepal-to-:corridor",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://flagcdn.com https://*.supabase.co https://images.unsplash.com https://*.gstatic.com https://thebccargo.com; connect-src 'self' https://cdn.jsdelivr.net https://*.supabase.co wss://*.supabase.co https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self';"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|svg|avif|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
